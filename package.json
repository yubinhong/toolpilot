{
  "name": "toolpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run models:check && next build && node scripts/generate-security-headers.mjs && npm run artifacts:check",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "cloudflare:build": "npm run lint && npm run typecheck && npm test && npm run build",
    "models:check": "node scripts/check-models.mjs",
    "artifacts:check": "node scripts/check-artifacts.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.4.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
